  "reset_menu": false,
  "char_lift": 0,
  "wgame": true,
  "ctile": true,
  "game_talk": [
    "잘 익었어요!",
    "패티처럼 든든한 한 판!",
    "치즈 녹듯 스르륵 지워졌네요.",
    "아삭하게 잘 마쳤어요!",
    "속이 꽉 찬 한 판이었어요.",
    "잘했어요, 한 입 더?",
    "번까지 깔끔했어요."
  ],
  "game_talk_win": [
    "전부 다 먹었어요! 아니, 지웠어요!",
    "한 장도 안 남았네요!",
    "완벽하게 구워졌어요."
  ],
  "g2_talk": {
    "start": [
      "주문 들어왔어요! 한 판이요.",
      "번부터 차곡차곡 쌓아요.",
      "따끈할 때 시작해요.",
      "오늘 세트로 갈까요?"
    ],
    "move_none": [
      "그쪽은 다 찼어요.",
      "소스가 좀 튀었네요.",
      "괜찮아요, 다시 잡아요.",
      "빵이 안 밀리네요."
    ],
    "big": [
      "오, 두툼해졌어요!",
      "패티가 커졌어요!",
      "치즈처럼 스르륵 녹았네요.",
      "속이 꽉 찼어요."
    ],
    "combo": [
      "삼단 버거 완성!",
      "한 번에 세 겹이요!",
      "층층이 잘 쌓였어요.",
      "세트 업그레이드예요!"
    ],
    "top": [
      "역대급 사이즈예요!",
      "최고 기록, 축하해요!",
      "이건 특대 사이즈네요.",
      "메뉴판에 올려야겠어요."
    ],
    "tight": [
      "포장지가 꽉 찼어요.",
      "한 입 크기로 정리해요.",
      "자리가 없어요. 침착히요.",
      "소스 흐르기 직전이에요."
    ],
    "idle": [
      "천천히 두셔도 돼요.",
      "감자튀김은 이따가요.",
      "따끈할 때 놓으면 좋아요.",
      "고민도 재료예요."
    ],
    "near": [
      "1024! 한 겹만 더요.",
      "마지막 번만 얹으면 돼요.",
      "완성이 코앞이에요.",
      "세트 완성 직전이에요!"
    ],
    "win": [
      "2048! 세트 완성이에요!",
      "속이 꽉 찬 한 판이었어요.",
      "완벽하게 잘 익었어요!",
      "포장해 드릴게요!"
    ],
    "over": [
      "여기까지도 든든했어요.",
      "아쉽네요. 한 입 더?",
      "재료는 또 있어요. 다시 해요.",
      "잘 쌓았어요, 오늘!"
    ]
  },
